<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        Title="Google 일정 추가" Width="450" Height="620" MinWidth="320" MinHeight="470"
        Background="{DynamicResource ThemeSurface}" Foreground="{DynamicResource ThemeText}" FontFamily="Malgun Gothic" FontSize="{DynamicResource ThemeFontSize}"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
 <Window.Resources>
  <ControlTemplate x:Key="ThemeButtonTemplate" TargetType="Button">
   <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
   </Border>
   <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonSurface" Property="BorderBrush" Value="{DynamicResource ThemeAccentOutline}"/><Setter TargetName="ButtonSurface" Property="BorderThickness" Value="1"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ButtonSurface" Property="BorderBrush" Value="{DynamicResource ThemeAccentOutline}"/><Setter TargetName="ButtonSurface" Property="BorderThickness" Value="2"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonSurface" Property="Background" Value="{DynamicResource ThemeSurfaceAlt}"/><Setter Property="Opacity" Value="0.65"/></Trigger></ControlTemplate.Triggers>
  </ControlTemplate>

  <ControlTemplate x:Key="ThemeComboTemplate" TargetType="ComboBox">
   <Grid MinHeight="30">
    <Border x:Name="Outline" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="5"/>
    <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" IsHitTestVisible="False" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="8,2,28,2"/>
    <ToggleButton x:Name="DropToggle" Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" ClickMode="Press"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent"/></ControlTemplate></ToggleButton.Template></ToggleButton>
    <Path Data="M 0 0 L 4 4 L 8 0" Stroke="{DynamicResource ThemeText}" StrokeThickness="1.5" Width="8" Height="5" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" IsHitTestVisible="False"/>
    <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
     <Border Width="{Binding PlacementTarget.ActualWidth, ElementName=PART_Popup}" MaxHeight="{TemplateBinding MaxDropDownHeight}" Background="{DynamicResource ThemeSurface}" BorderBrush="{DynamicResource ThemeInputBorder}" BorderThickness="1" Padding="2"><ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto"><ItemsPresenter/></ScrollViewer></Border>
    </Popup>
   </Grid>
   <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Outline" Property="BorderBrush" Value="{DynamicResource ThemeAccentOutline}"/><Setter TargetName="Outline" Property="BorderThickness" Value="2"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.65"/></Trigger></ControlTemplate.Triggers>
  </ControlTemplate>

  <Style TargetType="TextBox">
   <Setter Property="Foreground" Value="{DynamicResource ThemeText}"/><Setter Property="Background" Value="{DynamicResource ThemeSurface}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource ThemeInputBorder}"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="CaretBrush" Value="{DynamicResource ThemeAccent}"/><Setter Property="SelectionBrush" Value="{DynamicResource ThemeAccent}"/><Setter Property="SelectionOpacity" Value="0.3"/>
   <Setter Property="MinHeight" Value="32"/><Setter Property="Padding" Value="6,5"/>
   <Style.Triggers>
    <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource ThemeAccent}"/><Setter Property="BorderThickness" Value="2"/></Trigger>
    <Trigger Property="IsReadOnly" Value="True"><Setter Property="Background" Value="{DynamicResource ThemeSurfaceAlt}"/><Setter Property="Foreground" Value="{DynamicResource ThemeMuted}"/></Trigger>
    <Trigger Property="IsEnabled" Value="False"><Setter Property="Background" Value="{DynamicResource ThemeSurfaceAlt}"/><Setter Property="Foreground" Value="{DynamicResource ThemeMuted}"/></Trigger>
   </Style.Triggers>
  </Style>
  <Style TargetType="{x:Type primitives:DatePickerTextBox}">
   <Setter Property="Foreground" Value="{DynamicResource ThemeText}"/><Setter Property="Background" Value="{DynamicResource ThemeSurface}"/>
   <Setter Property="CaretBrush" Value="{DynamicResource ThemeAccent}"/><Setter Property="SelectionBrush" Value="{DynamicResource ThemeAccent}"/>
  </Style>
  <Style TargetType="ComboBox"><Setter Property="Template" Value="{StaticResource ThemeComboTemplate}"/>
   <Setter Property="Foreground" Value="{DynamicResource ThemeText}"/><Setter Property="Background" Value="{DynamicResource ThemeSurface}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource ThemeInputBorder}"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="ItemContainerStyle"><Setter.Value><Style TargetType="ComboBoxItem">
    <Setter Property="Foreground" Value="{DynamicResource ThemeText}"/><Setter Property="Background" Value="{DynamicResource ThemeSurface}"/><Setter Property="Padding" Value="8,6"/>
    <Style.Triggers>
     <Trigger Property="IsHighlighted" Value="True"><Setter Property="Background" Value="{DynamicResource ThemeSurfaceTint}"/><Setter Property="Foreground" Value="{DynamicResource ThemeText}"/></Trigger>
     <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource ThemeSurfaceTint}"/><Setter Property="Foreground" Value="{DynamicResource ThemeText}"/></Trigger>
    </Style.Triggers>
   </Style></Setter.Value></Setter>
   <Style.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource ThemeAccent}"/></Trigger>
    <Trigger Property="IsEnabled" Value="False"><Setter Property="Background" Value="{DynamicResource ThemeSurfaceAlt}"/><Setter Property="Foreground" Value="{DynamicResource ThemeMuted}"/></Trigger></Style.Triggers>
  </Style>
  <Style TargetType="DatePicker"><Setter Property="Foreground" Value="{DynamicResource ThemeText}"/><Setter Property="Background" Value="{DynamicResource ThemeSurface}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource ThemeInputBorder}"/></Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{DynamicResource ThemeText}"/></Style>
  <Style TargetType="Button"><Setter Property="Template" Value="{StaticResource ThemeButtonTemplate}"/><Setter Property="Foreground" Value="{DynamicResource ThemeText}"/><Setter Property="Background" Value="{DynamicResource ThemeSurfaceTint}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource ThemeInputBorder}"/><Setter Property="Padding" Value="9,7"/></Style>
 </Window.Resources>
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="18">
  <TextBlock Text="Google 일정 추가" FontSize="21" FontWeight="SemiBold"/>
  <TextBlock Text="선택한 Google 캘린더에만 등록합니다 · Asia/Seoul (UTC+09:00)" Foreground="{DynamicResource ThemeMuted}" Margin="0,5,0,14" TextWrapping="Wrap"/>
  <TextBlock Text="캘린더" Margin="0,0,0,4"/><ComboBox x:Name="ManualCalendarSelect" MinHeight="32" DisplayMemberPath="Label"/>
  <TextBlock Text="제목" Margin="0,13,0,4"/><TextBox x:Name="ManualTitle" MaxLength="200"/>
  <CheckBox x:Name="ManualAllDay" Content="종일 일정" Margin="0,13,0,7"/>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <StackPanel Margin="0,0,5,0"><TextBlock Text="시작 날짜" Margin="0,0,0,4"/><DatePicker x:Name="ManualStartDate"/></StackPanel>
   <StackPanel Grid.Column="1" Margin="5,0,0,0"><TextBlock x:Name="EndDateLabel" Text="종료 날짜" Margin="0,0,0,4"/><DatePicker x:Name="ManualEndDate"/></StackPanel>
  </Grid>
  <Grid x:Name="ManualTimes" Margin="0,11,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <StackPanel Margin="0,0,5,0"><TextBlock Text="시작 시간 (HH:mm)" Margin="0,0,0,4"/><TextBox x:Name="ManualStartTime"/></StackPanel>
   <StackPanel Grid.Column="1" Margin="5,0,0,0"><TextBlock Text="종료 시간 (HH:mm)" Margin="0,0,0,4"/><TextBox x:Name="ManualEndTime"/></StackPanel>
  </Grid>
  <TextBlock x:Name="ManualPeriodHint" Text="종일 일정은 종료 날짜 다음 날까지 표시됩니다." Visibility="Collapsed" Foreground="{DynamicResource ThemeMuted}" Margin="0,8,0,0" TextWrapping="Wrap"/>
  <Expander x:Name="ManualStatusExpander" Header="상태 직접 입력 (선택)" Margin="0,14,0,0" Foreground="{DynamicResource ThemeText}" Background="{DynamicResource ThemeSurfaceAlt}">
   <StackPanel Margin="10,6,10,10">
    <TextBlock Text="비워두면 상태를 만들지 않습니다. 입력값은 Google 일정 설명의 앱 관리 영역에 저장됩니다." TextWrapping="Wrap" Foreground="{DynamicResource ThemeMuted}" Margin="0,0,0,8"/>
    <TextBlock Text="세팅"/><TextBox x:Name="ManualStatusSetup" MaxLength="256"/>
    <TextBlock Text="알파 확인" Margin="0,8,0,0"/><TextBox x:Name="ManualStatusAlphaCheck" MaxLength="256"/>
    <TextBlock Text="알파 테스터" Margin="0,8,0,0"/><TextBox x:Name="ManualStatusAlphaTester" MaxLength="256"/>
    <TextBlock Text="리얼 확인" Margin="0,8,0,0"/><TextBox x:Name="ManualStatusRealCheck" MaxLength="256"/>
    <TextBlock Text="리얼 테스터" Margin="0,8,0,0"/><TextBox x:Name="ManualStatusRealTester" MaxLength="256"/>
   </StackPanel>
  </Expander>
  <TextBlock Text="참석자·초대·Meet·링크·기본 알림은 자동으로 추가하지 않습니다." Foreground="{DynamicResource ThemeMuted}" FontSize="{DynamicResource ThemeSmallSize}" Margin="0,15,0,0" TextWrapping="Wrap"/>
  <TextBlock x:Name="ManualResult" Foreground="{DynamicResource ThemeAccentOutline}" Margin="0,12,0,0" TextWrapping="Wrap"/>
  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
   <Button x:Name="ManualCancelButton" Content="취소" MinWidth="75" Margin="0,0,8,0"/>
   <Button x:Name="ManualSaveButton" Content="Google에 등록" Foreground="{DynamicResource ThemeAccentText}" Background="{DynamicResource ThemeAccent}" MinWidth="145"/>
  </StackPanel>
 </StackPanel></ScrollViewer>
</Window>
