<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="캘린더 변경 미리보기" Width="850" Height="670" MinWidth="640" MinHeight="440" Background="{DynamicResource ThemeBackground}" FontFamily="Malgun Gothic" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
 <Window.Resources>
  <ControlTemplate x:Key="ThemeButtonTemplate" TargetType="Button">
   <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
   </Border>
   <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonSurface" Property="BorderBrush" Value="{DynamicResource ThemeAccentOutline}"/><Setter TargetName="ButtonSurface" Property="BorderThickness" Value="1"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ButtonSurface" Property="BorderBrush" Value="{DynamicResource ThemeAccentOutline}"/><Setter TargetName="ButtonSurface" Property="BorderThickness" Value="2"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonSurface" Property="Background" Value="{DynamicResource ThemeSurfaceAlt}"/><Setter Property="Opacity" Value="0.65"/></Trigger></ControlTemplate.Triggers>
  </ControlTemplate>

  <Style TargetType="Button"><Setter Property="Template" Value="{StaticResource ThemeButtonTemplate}"/><Setter Property="Foreground" Value="{DynamicResource ThemeText}"/><Setter Property="Background" Value="{DynamicResource ThemeSurfaceTint}"/><Setter Property="BorderBrush" Value="{DynamicResource ThemeInputBorder}"/><Setter Property="Padding" Value="9,6"/></Style>
  <Style TargetType="TextBox"><Setter Property="Foreground" Value="{DynamicResource ThemeText}"/><Setter Property="Background" Value="{DynamicResource ThemeSurface}"/><Setter Property="BorderBrush" Value="{DynamicResource ThemeInputBorder}"/><Setter Property="CaretBrush" Value="{DynamicResource ThemeText}"/></Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{DynamicResource ThemeText}"/></Style>
  <Style TargetType="DataGrid"><Setter Property="Foreground" Value="{DynamicResource ThemeText}"/><Setter Property="Background" Value="{DynamicResource ThemeSurface}"/><Setter Property="RowBackground" Value="{DynamicResource ThemeSurface}"/><Setter Property="AlternatingRowBackground" Value="{DynamicResource ThemeSurfaceAlt}"/><Setter Property="BorderBrush" Value="{DynamicResource ThemeInputBorder}"/></Style>
  <Style TargetType="DataGridColumnHeader"><Setter Property="Foreground" Value="{DynamicResource ThemeText}"/><Setter Property="Background" Value="{DynamicResource ThemeSurfaceTint}"/><Setter Property="BorderBrush" Value="{DynamicResource ThemeInputBorder}"/></Style>
  <Style TargetType="DataGridCell"><Setter Property="Foreground" Value="{DynamicResource ThemeText}"/><Setter Property="Background" Value="Transparent"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="{DynamicResource ThemeAccentText}"/><Setter Property="Background" Value="{DynamicResource ThemeAccent}"/></Trigger></Style.Triggers></Style>
 </Window.Resources>
 <Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="변경 미리보기" FontSize="23" FontWeight="SemiBold"/><TextBlock x:Name="PreviewSummary" TextWrapping="Wrap" Margin="0,8,0,12" Foreground="{DynamicResource ThemeInfo}"/></StackPanel>
  <ScrollViewer Grid.Row="1" MaxHeight="90" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10"><TextBlock x:Name="PreviewWarnings" TextWrapping="Wrap" Foreground="{DynamicResource ThemeWarning}"/></ScrollViewer>
  <DataGrid Grid.Row="2" x:Name="PlanGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended" CanUserAddRows="False" RowHeaderWidth="0" HeadersVisibility="Column"><DataGrid.Columns>
   <DataGridTextColumn Header="동작" Binding="{Binding Action}" Width="68"/><DataGridTextColumn Header="일정" Binding="{Binding Title}" Width="*"/><DataGridTextColumn Header="한국 시간" Binding="{Binding Schedule}" Width="145"/><DataGridTextColumn Header="판정 이유" Binding="{Binding Reason}" Width="230"/><DataGridTextColumn Header="원본 ID" Binding="{Binding StableId}" Width="130"/>
  </DataGrid.Columns></DataGrid>
  <StackPanel Grid.Row="3" Margin="0,12,0,12">
   <TextBlock Text="같은 일정이 선택한 캘린더에 없으면 신규 확인하세요. 이는 원본 ID 확인 단계이며, 실제 등록은 아래 동기화 버튼에서 별도로 실행합니다." TextWrapping="Wrap" Foreground="{DynamicResource ThemeInfo}" Margin="0,0,0,6"/>
   <WrapPanel><Button x:Name="ImportMappingButton" Content="기존 Google ID 매핑 가져오기" Padding="10,6" Margin="0,0,8,8"/><Button x:Name="SelectConfirmableButton" Content="신규 확인 가능 항목 전체 선택" Padding="10,6" Margin="0,0,8,8"/><Button x:Name="ClearPlanSelectionButton" Content="선택 해제" Padding="10,6" Margin="0,0,8,8"/><Button x:Name="ConfirmNewButton" Content="선택 항목 일괄 신규 확인" Padding="10,6" Margin="0,0,8,8"/></WrapPanel>
   <TextBlock x:Name="NewConfirmationCount" TextWrapping="Wrap" Foreground="{DynamicResource ThemeInfo}" Margin="0,0,0,6"/>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="ExistingSourceId" MinHeight="28" Padding="6" ToolTip="같은 원본의 기존 안정 ID를 입력"/><Button x:Name="BindIdentityButton" Grid.Column="1" Content="기존 원본 ID 연결" Padding="10,6" Margin="8,0,0,0"/></Grid>
   <CheckBox x:Name="ReviewWarningsCheck" Content="원본 경고와 신규/변경/채택 항목을 확인했습니다." Margin="0,10,0,4"/><ScrollViewer MaxHeight="100" VerticalScrollBarVisibility="Auto"><TextBlock x:Name="PreviewStatus" TextWrapping="Wrap" Foreground="{DynamicResource ThemeError}"/></ScrollViewer>
  </StackPanel>
  <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="BackButton" Content="설정으로 돌아가기" Padding="12,8" Margin="0,0,8,0"/><Button x:Name="ExecuteSyncButton" Content="구글 캘린더로 동기화" Padding="12,8" IsEnabled="False"/></StackPanel>
 </Grid>
</Window>
