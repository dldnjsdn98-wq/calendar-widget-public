<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="캘린더 위젯 설정" Width="620" Height="730" MinWidth="500" MinHeight="480" Background="{DynamicResource ThemeBackground}" FontFamily="Malgun Gothic" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
 <Window.Resources>
  <ControlTemplate x:Key="ThemeButtonTemplate" TargetType="Button">
   <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
   </Border>
   <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonSurface" Property="BorderBrush" Value="{DynamicResource ThemeAccentOutline}"/><Setter TargetName="ButtonSurface" Property="BorderThickness" Value="1"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ButtonSurface" Property="BorderBrush" Value="{DynamicResource ThemeAccentOutline}"/><Setter TargetName="ButtonSurface" Property="BorderThickness" Value="2"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonSurface" Property="Background" Value="{DynamicResource ThemeSurfaceAlt}"/><Setter Property="Opacity" Value="0.65"/></Trigger></ControlTemplate.Triggers>
  </ControlTemplate>

  <ControlTemplate x:Key="ThemeComboTemplate" TargetType="ComboBox">
   <Grid MinHeight="30">
    <Border x:Name="Outline" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="5"/>
    <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" IsHitTestVisible="False" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="8,2,28,2"/>
    <ToggleButton x:Name="DropToggle" Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" ClickMode="Press"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent"/></ControlTemplate></ToggleButton.Template></ToggleButton>
    <Path Data="M 0 0 L 4 4 L 8 0" Stroke="{DynamicResource ThemeText}" StrokeThickness="1.5" Width="8" Height="5" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" IsHitTestVisible="False"/>
    <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
     <Border Width="{Binding PlacementTarget.ActualWidth, ElementName=PART_Popup}" MaxHeight="{TemplateBinding MaxDropDownHeight}" Background="{DynamicResource ThemeSurface}" BorderBrush="{DynamicResource ThemeInputBorder}" BorderThickness="1" Padding="2"><ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto"><ItemsPresenter/></ScrollViewer></Border>
    </Popup>
   </Grid>
   <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Outline" Property="BorderBrush" Value="{DynamicResource ThemeAccentOutline}"/><Setter TargetName="Outline" Property="BorderThickness" Value="2"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.65"/></Trigger></ControlTemplate.Triggers>
  </ControlTemplate>

  <Style TargetType="TextBox"><Setter Property="MinHeight" Value="29"/><Setter Property="Padding" Value="6"/><Setter Property="Foreground" Value="{DynamicResource ThemeText}"/><Setter Property="Background" Value="{DynamicResource ThemeSurface}"/><Setter Property="BorderBrush" Value="{DynamicResource ThemeInputBorder}"/><Setter Property="CaretBrush" Value="{DynamicResource ThemeText}"/><Setter Property="SelectionBrush" Value="{DynamicResource ThemeAccentOutline}"/></Style>
  <Style TargetType="PasswordBox"><Setter Property="Foreground" Value="{DynamicResource ThemeText}"/><Setter Property="Background" Value="{DynamicResource ThemeSurface}"/><Setter Property="BorderBrush" Value="{DynamicResource ThemeInputBorder}"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Template" Value="{StaticResource ThemeComboTemplate}"/><Setter Property="Foreground" Value="{DynamicResource ThemeText}"/><Setter Property="Background" Value="{DynamicResource ThemeSurface}"/><Setter Property="BorderBrush" Value="{DynamicResource ThemeInputBorder}"/><Setter Property="ItemContainerStyle"><Setter.Value><Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="{DynamicResource ThemeText}"/><Setter Property="Background" Value="{DynamicResource ThemeSurface}"/><Style.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter Property="Background" Value="{DynamicResource ThemeSurfaceTint}"/><Setter Property="Foreground" Value="{DynamicResource ThemeText}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource ThemeSurfaceTint}"/><Setter Property="Foreground" Value="{DynamicResource ThemeText}"/></Trigger></Style.Triggers></Style></Setter.Value></Setter></Style>
  <Style TargetType="Button"><Setter Property="Template" Value="{StaticResource ThemeButtonTemplate}"/><Setter Property="Padding" Value="12,7"/><Setter Property="Foreground" Value="{DynamicResource ThemeText}"/><Setter Property="Background" Value="{DynamicResource ThemeSurfaceTint}"/><Setter Property="BorderBrush" Value="{DynamicResource ThemeInputBorder}"/></Style>
  <Style TargetType="TabControl"><Setter Property="Foreground" Value="{DynamicResource ThemeText}"/><Setter Property="Background" Value="{DynamicResource ThemeSurface}"/><Setter Property="BorderBrush" Value="{DynamicResource ThemeBorder}"/></Style>
  <Style TargetType="TabItem"><Setter Property="Foreground" Value="{DynamicResource ThemeText}"/><Setter Property="Background" Value="{DynamicResource ThemeSurfaceAlt}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="TabSurface" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" Padding="9,7" Margin="0,0,3,0"><ContentPresenter ContentSource="Header"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="TabSurface" Property="Background" Value="{DynamicResource ThemeSurfaceTint}"/><Setter TargetName="TabSurface" Property="BorderBrush" Value="{DynamicResource ThemeAccentOutline}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="TabSurface" Property="BorderThickness" Value="2"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
 </Window.Resources>
 <DockPanel Margin="18">
  <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0"><TextBlock x:Name="SettingsStatus" Foreground="{DynamicResource ThemeError}" Margin="0,0,0,8"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="CancelSettingsButton" Content="취소" Margin="0,0,8,0"/><Button x:Name="SaveSettingsButton" Content="설정 저장"/></StackPanel></StackPanel>
  <TabControl x:Name="ConfigTabs">
   <TabItem Header="계정"><ScrollViewer x:Name="AccountScroll" VerticalScrollBarVisibility="Auto"><StackPanel Margin="16">
    <TextBlock Text="Google 계정과 대상 캘린더" FontSize="{DynamicResource ThemeTitleSize}" FontWeight="SemiBold"/><TextBlock x:Name="ConnectionStatus" Text="미연결 · 이메일 입력은 인증이 아닙니다." Foreground="{DynamicResource ThemeSecondary}" Margin="0,10,0,12"/>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox x:Name="AccountSelect" MinHeight="30"/><Button x:Name="AddAccountButton" Grid.Column="1" Content="계정 추가" Margin="8,0,0,0"/></Grid>
    <TextBlock Text="표시 이름" Margin="0,12,0,4"/><TextBox x:Name="AccountName"/><TextBlock Text="이메일 (계정 구분용)" Margin="0,9,0,4"/><TextBox x:Name="AccountEmail"/>
    <TextBlock Text="Google 데스크톱 OAuth 클라이언트 JSON" Margin="0,14,0,4"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="OAuthClientPath" IsReadOnly="True"/><Button x:Name="BrowseOAuthClientButton" Grid.Column="1" Content="선택" Margin="8,0,0,0"/></Grid>
    <Button x:Name="ConnectGoogleButton" Content="Google 계정 연결" Margin="0,10,0,8"/><TextBlock Text="계정 확인(openid/email), 캘린더 목록 읽기, 본인 소유 일정 읽기·추가·갱신 권한을 요청합니다. 사용자 동의 후 토큰은 PC 사용자 암호화로 저장합니다." FontSize="{DynamicResource ThemeSmallSize}" Foreground="{DynamicResource ThemeInfo}"/>
    <Button x:Name="LoadCalendarsButton" Content="연결된 캘린더 목록 읽기" Margin="0,14,0,8"/><ComboBox x:Name="TargetCalendarSelect" MinHeight="30" DisplayMemberPath="Name" SelectedValuePath="Id"/>
    <TextBlock Text="대상 캘린더 ID (목록 확인 전 수동 입력 가능)" Margin="0,9,0,4"/><TextBox x:Name="TargetCalendarId"/><TextBlock Text="참고용 ID 목록 (동시에 등록하지 않음)" Margin="0,9,0,4"/><TextBox x:Name="AccountCalendars"/>
    <TextBlock Text="현재 기본 권한은 본인 소유 캘린더입니다. 공유 캘린더의 추가 권한은 별도 확인이 필요합니다." FontSize="{DynamicResource ThemeSmallSize}" Foreground="{DynamicResource ThemeInfo}" Margin="0,10,0,0"/>
   </StackPanel></ScrollViewer></TabItem>
      <TabItem Header="캘린더 연결"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="16">
    <TextBlock Text="캘린더 연결 프로필" FontSize="{DynamicResource ThemeTitleSize}" FontWeight="SemiBold"/>
    <TextBlock Text="계정과 실제 캘린더를 선택한 뒤, Google 직접 일정 또는 지원하는 Excel 양식을 고르세요. 직접 일정은 Google 캘린더에서 등록하며 위젯에서는 읽어 표시합니다." Foreground="{DynamicResource ThemeInfo}" Margin="0,8,0,12"/>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox x:Name="ConnectionProfileSelect" MinHeight="30"/><Button x:Name="AddConnectionButton" Grid.Column="1" Content="연결 추가" Margin="8,0,0,0"/></Grid>
    <TextBlock Text="Google 계정" Margin="0,13,0,4"/><ComboBox x:Name="ProfileAccountSelect" MinHeight="30"/>
    <Button x:Name="LoadProfileCalendarsButton" Content="계정의 캘린더 목록 읽기" Margin="0,8,0,4"/><ComboBox x:Name="ProfileCalendarSelect" MinHeight="30" DisplayMemberPath="Name" SelectedValuePath="Id"/>
    <TextBlock Text="연결 방식" Margin="0,13,0,4"/><ComboBox x:Name="ProfileModeSelect" MinHeight="30"><ComboBoxItem Content="Google 직접 · 캘린더에서 등록한 일정 읽기" Tag="google-direct"/><ComboBoxItem Content="Excel 달력 · 지원하는 xlsx 미리보기/동기화" Tag="excel"/></ComboBox>
    <TextBlock Text="표시 이름 (선택 · 실제 캘린더 이름도 함께 표시)" Margin="0,13,0,4"/><TextBox x:Name="ProfileDisplayName"/>
    <StackPanel x:Name="ProfileExcelFields" Margin="0,12,0,0"><TextBlock Text="지원하는 Excel xlsx 파일" Margin="0,0,0,4"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="ProfileWorkbookPath" IsReadOnly="True"/><Button x:Name="BrowseProfileWorkbookButton" Grid.Column="1" Content="xlsx 선택" Margin="8,0,0,0"/></Grid><TextBlock Text="시트 이름" Margin="0,8,0,4"/><TextBox x:Name="ProfileWorksheet"/><Button x:Name="ProfilePreviewButton" Content="이 프로필 미리보기 · 확인 후 동기화" Margin="0,12,0,0"/></StackPanel>
    <TextBlock Text="방식을 바꿔도 기존 일정·매핑을 삭제하거나 다시 등록하지 않습니다. 같은 계정과 캘린더의 중복 연결은 저장할 수 없습니다." Foreground="{DynamicResource ThemeInfo}" FontSize="{DynamicResource ThemeSmallSize}" Margin="0,15,0,0"/>
   </StackPanel></ScrollViewer></TabItem><TabItem Header="원본과 동기화"><ScrollViewer x:Name="SourceScroll" VerticalScrollBarVisibility="Auto"><StackPanel Margin="16">
    <TextBlock Text="다운로드한 원본과 변경 미리보기" FontSize="{DynamicResource ThemeTitleSize}" FontWeight="SemiBold"/>
    <TextBlock Text="1. SharePoint 공식 페이지를 열어 최신 xlsx를 다운로드하세요." Margin="0,12,0,4"/><TextBlock Text="SharePoint 링크 (화면·저장에서 보호)"/><PasswordBox x:Name="SourceSharingLink" MinHeight="30" Padding="6" Margin="0,4,0,6"/><Button x:Name="OpenSourceButton" Content="SharePoint 원본 열기"/>
    <TextBlock Text="2. 다운로드한 최신 브라운팜.xlsx를 선택하세요." Margin="0,14,0,6"/>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="SourceWorkbookPath" IsReadOnly="True"/><Button x:Name="BrowseWorkbookButton" Grid.Column="1" Content="xlsx 선택" Margin="8,0,0,0"/></Grid>
    <TextBlock Text="파일 수정 시각과 불러온 시각은 미리보기에서 확인합니다. 로컬 파일의 시각만으로 서버 최신성을 보장하지 않습니다." FontSize="{DynamicResource ThemeSmallSize}" Foreground="{DynamicResource ThemeInfo}" Margin="0,8,0,0"/>
    <Expander Header="고급 옵션 · 원본 열 / 직접 Microsoft 읽기" Margin="0,14,0,6"><StackPanel Margin="0,8,0,0">
     <ComboBox x:Name="SourceKindSelect" MinHeight="30" Margin="0,0,0,8"><ComboBoxItem Content="SharePoint 직접 읽기 (추가 앱 설정)" Tag="sharepoint"/><ComboBoxItem Content="다운로드한 로컬 xlsx" Tag="local"/></ComboBox>
     <TextBlock Text="기준 연도 · 날짜 열 · 단계 열 · 제목 열 · 리얼 제목 열" Margin="0,9,0,4"/><TextBox x:Name="ColumnSettings" ToolTip="예: 2026,A,B,C,J"/><TextBlock Text="단계 일정 표시 길이(분, 0이면 기존 일정 길이만 사용)" Margin="0,9,0,4"/><TextBox x:Name="PhaseMinutes"/><TextBlock Text="일정 제목 접두어 (선택)" Margin="0,9,0,4"/><TextBox x:Name="SummaryPrefix"/>
     <TextBlock Text="직접 클라우드 읽기용 Microsoft Client ID (다운로드 흐름에는 필요 없음)" Margin="0,12,0,4"/><TextBox x:Name="MicrosoftClientId"/><TextBlock Text="테넌트" Margin="0,9,0,4"/><TextBox x:Name="MicrosoftTenant"/><Button x:Name="ConnectMicrosoftButton" Content="Microsoft 문서 읽기 연결 (고급)" Margin="0,10,0,8"/>
    </StackPanel></Expander>
     <TextBlock Text="상태 정보 시트" Margin="0,9,0,4"/><TextBox x:Name="SourceWorksheet"/><TextBlock Text="상태 정보는 이벤트확인 시트에서 읽습니다. 일정은 이벤트 정렬 시트를 자동으로 읽고, 원본은 이벤트달력 test 시트를 참조합니다." FontSize="{DynamicResource ThemeSmallSize}" Foreground="{DynamicResource ThemeInfo}" Margin="0,5,0,8" TextWrapping="Wrap"/><TextBlock Text="동기화할 Google 계정" Margin="0,8,0,4"/><ComboBox x:Name="SourceAccountSelect" MinHeight="30" DisplayMemberPath="DisplayName"/><Button x:Name="LoadSourceCalendarsButton" Content="동기화 대상 캘린더 불러오기" Margin="0,8,0,5"/><ComboBox x:Name="SourceCalendarSelect" MinHeight="30" DisplayMemberPath="Name" SelectedValuePath="Id"/><TextBlock Text="미리보기와 동기화는 여기서 선택한 캘린더 한 곳에만 적용됩니다." FontSize="{DynamicResource ThemeSmallSize}" Foreground="{DynamicResource ThemeInfo}" Margin="0,5,0,8"/><Button x:Name="ReadSourceButton" Content="원본 읽고 변경 미리보기" Margin="0,14,0,8"/><Button x:Name="SyncButton" Content="구글 캘린더로 동기화" IsEnabled="False" ToolTip="미리보기에서 원격 확인 후 실행합니다." ToolTipService.ShowOnDisabled="True"/>
    <TextBlock Text="원본 읽기는 Google 쓰기와 별도입니다. 샘플은 실데이터로 표시하지 않습니다. 신규/변경 계획과 기존 ID 채택을 검토한 뒤 동기화합니다. 삭제하지 않습니다." FontSize="{DynamicResource ThemeSmallSize}" Foreground="{DynamicResource ThemeInfo}" Margin="0,10,0,0"/>
   </StackPanel></ScrollViewer></TabItem>
   <TabItem Header="표시"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="16"><TextBlock Text="캘린더별 추가 필드" FontSize="{DynamicResource ThemeTitleSize}" FontWeight="SemiBold"/><ComboBox x:Name="FieldCalendarSelect" MinHeight="30" DisplayMemberPath="Name" SelectedValuePath="Id" Margin="0,14,0,10"/><StackPanel x:Name="FieldChoices"/><TextBlock Text="기본 일정명과 한국 시간은 항상 표시합니다. 계정 이메일·로컬 경로는 설정에만, 인증 토큰과 비공개 링크는 사용자 암호화로 분리 저장합니다." Foreground="{DynamicResource ThemeInfo}" FontSize="{DynamicResource ThemeSmallSize}" Margin="0,12,0,0"/></StackPanel></ScrollViewer></TabItem>
   <TabItem Header="표시 · 꾸미기"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="16">
    <TextBlock Text="달력 표시" FontSize="{DynamicResource ThemeTitleSize}" FontWeight="SemiBold"/>
    <TextBlock Text="앱 화면에만 적용됩니다. 컴퓨터 테마와 설치된 글꼴은 변경하지 않습니다." Foreground="{DynamicResource ThemeInfo}" Margin="0,8,0,16"/>
    <TextBlock Text="테마" Margin="0,0,0,5"/><ComboBox x:Name="ThemeSelect" MinHeight="32"><ComboBoxItem Content="라이트" Tag="light"/><ComboBoxItem Content="다크" Tag="dark"/><ComboBoxItem Content="시스템 설정 따르기" Tag="system"/></ComboBox>
    <TextBlock Text="글꼴" Margin="0,16,0,5"/><ComboBox x:Name="FontSelect" MinHeight="32" MaxDropDownHeight="250" IsTextSearchEnabled="True"/>
    <TextBlock Text="글자 크기" Margin="0,16,0,5"/><StackPanel Orientation="Horizontal"><Slider x:Name="FontSizeSelect" Minimum="11" Maximum="18" TickFrequency="1" IsSnapToTickEnabled="True" Width="240" VerticalAlignment="Center"/><TextBlock x:Name="FontSizeLabel" Margin="10,0,0,0" VerticalAlignment="Center"/></StackPanel>
    <Button x:Name="ResetAppearanceButton" Content="표시 기본값 복원" HorizontalAlignment="Left" Margin="0,16,0,0"/>
    <Border Background="{DynamicResource ThemeSurfaceAlt}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,20,0,0"><StackPanel><TextBlock Text="미리보기" Foreground="{DynamicResource ThemeMuted}"/><TextBlock x:Name="AppearancePreview" Text="2026년 10월 6일 · 일정 제목과 상태 입력" TextWrapping="Wrap" Margin="0,10,0,0"/></StackPanel></Border>
    <TextBlock Text="일정 변경 알림" FontWeight="SemiBold" Margin="0,18,0,5"/>
    <CheckBox x:Name="ChangeAlertsEnabled" Content="5분 조회에서 발견한 변경을 알리기" IsChecked="True" Margin="0,6,0,8"/>
    <Button x:Name="PauseChangeAlertsButton" Content="알림 1시간 일시중지" HorizontalAlignment="Left"/>
    <TextBlock x:Name="ChangeAlertsPauseInfo" Foreground="{DynamicResource ThemeMuted}" Margin="0,5,0,0"/>
    <TextBlock Text="큰 글자에서는 달력과 편집 창을 스크롤하여 내용을 확인할 수 있습니다." Foreground="{DynamicResource ThemeInfo}" Margin="0,14,0,0"/>
   </StackPanel></ScrollViewer></TabItem>
   <TabItem Header="업데이트"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="16">
    <TextBlock Text="앱 업데이트" FontSize="{DynamicResource ThemeTitleSize}" FontWeight="SemiBold"/>
    <TextBlock Text="동기화 공유 폴더 경로 또는 HTTPS release.json 주소를 지정하세요. 저장 후 5분마다 새 릴리스 번호를 확인합니다." TextWrapping="Wrap" Foreground="{DynamicResource ThemeInfo}" Margin="0,10,0,12"/>
    <TextBlock Text="릴리스 위치" Margin="0,0,0,5"/><TextBox x:Name="ReleaseFeed" AutomationProperties.Name="업데이트 릴리스 위치"/>
    <TextBlock Text="원본 일정, 로그인 정보, 개인 설정은 업데이트 패키지에 넣지 않습니다. 새 버전 적용 중 앱을 재시작하고 실패하면 이전 실행본을 복원합니다." TextWrapping="Wrap" Foreground="{DynamicResource ThemeMuted}" Margin="0,12,0,0"/>
   </StackPanel></ScrollViewer></TabItem>
  </TabControl>
 </DockPanel>
</Window>

